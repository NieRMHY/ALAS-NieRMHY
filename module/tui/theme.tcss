/* AzurPilot TUI 现代化深色主题与网格样式 */

Screen {
    background: #090d13;
    color: #e6edf3;
}

#main-layout {
    width: 100%;
    height: 100%;
}

#content-pane {
    height: 100%;
    width: 1fr;
    padding: 0 1;
}

/* 按钮与交互控件微调 */
Button {
    min-width: 12;
    height: 3;
}

Button:focus {
    text-style: bold underline;
}

DataTable {
    background: #12171f;
    color: #c9d1d9;
}

DataTable > .datatable--cursor {
    background: #1f6feb;
    color: #ffffff;
    text-style: bold;
}

DataTable > .datatable--header {
    background: #161b22;
    color: #58a6ff;
    text-style: bold;
}

RichLog {
    background: #090d13;
    border: solid #30363d;
}

RichLog:focus {
    border: solid #58a6ff;
}

OptionList {
    background: #12171f;
    color: #c9d1d9;
}

OptionList > .option-list--option-highlighted {
    background: #1f6feb;
    color: #ffffff;
    text-style: bold;
}
